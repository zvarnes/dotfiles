# Shared shell aliases — sourced by both ~/.bashrc and ~/.zshrc.
# Keep this shell-agnostic (no zsh/bash-only syntax).

# Docker Compose — use the standalone `docker-compose` binary. It's always on
# PATH wherever it's installed; the `docker compose` plugin form only works
# where the CLI plugin is wired in (e.g. Docker Desktop), so it breaks on plain
# brew/apt setups. On Linux, add yourself to the docker group to avoid sudo:
#   sudo usermod -aG docker "$USER"   (then log out/in)
alias dcup='docker-compose -f docker-compose.yml up -d'   # up all (or named) containers, detached
alias dcdown='docker-compose -f docker-compose.yml stop'  # stop all (or named) containers
alias dcpull='docker-compose -f docker-compose.yml pull'  # pull all (or named) images
alias dclogs='docker-compose -f docker-compose.yml logs -tf --tail="50" '
alias dtail='docker logs -tf --tail="50" "$@"'

# Editors
alias vim='nvim'
alias n='vim'

# Listing (lsd)
alias ls='lsd'
alias l='ls'
alias ll='ls -la'
alias la='ls -A'

# cat -> bat (packaged as "batcat" on Debian/Ubuntu)
if command -v bat >/dev/null 2>&1; then
	alias cat='bat -pP'
elif command -v batcat >/dev/null 2>&1; then
	alias cat='batcat -pP'
fi
